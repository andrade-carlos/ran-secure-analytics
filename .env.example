# Copy to .env and change every password before starting the stack.
# .env is git-ignored: never commit real credentials.

HORIZON_VERSION=36.0.4
GRAFANA_VERSION=12.4.0
POSTGRES_VERSION=16
TZ=UTC

POSTGRES_PASSWORD=change-me-postgres
OPENNMS_DB_PASSWORD=change-me-opennms-db

# OpenNMS web/API account used by provision.sh and the Grafana datasources.
# After the first start, change the OpenNMS "admin" password in the web UI and set it here,
# between single quotes. Do NOT use "$" in this password: Grafana expands environment
# variables twice when it provisions the datasources, so "$#", "$1"... would be removed from
# the password Grafana sends to OpenNMS (it then fails with "Authentication to data source failed").
OPENNMS_API_USER=admin
OPENNMS_API_PASSWORD=admin

GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Ports are published on localhost only. On a cloud VM put a TLS reverse proxy
# (e.g. Caddy or Nginx) in front instead of exposing 8980/3000 directly.
BIND_ADDR=127.0.0.1

# Horizon JVM heap (the VM needs about 4 GB RAM for the whole stack)
HORIZON_JAVA_OPTS="-Xms1g -Xmx2g"

# ---- Cloud deployment only (deploy/docker-compose.cloud.yml) ----
# DNS A records for both names must point to the server's static IP.
ACME_EMAIL=you@example.com
ONMS_HOST=nms.example.com
GRAFANA_HOST=grafana.example.com
