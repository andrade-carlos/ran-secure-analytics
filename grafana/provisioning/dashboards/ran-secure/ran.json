      "type": "timeseries",
      "title": "Baseband CPU load",
      "description": "",
      "datasource": {
        "type": "opennms-performance-datasource",
        "uid": "${ds_perf}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "opennms-performance-datasource",
            "uid": "${ds_perf}"
          },
          "hide": false,
          "performanceType": {
            "label": "Attribute",
            "value": 1
          },
          "attribute": {
            "node": {
              "id": "RAN-Sim:$site",
              "label": "$site"
            },
            "resource": {
              "id": "nodeSnmp[]",
              "label": "nodeSnmp[]"
            },
            "attribute": {
              "name": "ranNodeCpuLoad"
            },
            "aggregation": {
              "label": "AVERAGE"
            },
            "label": "CPU"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
