         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>14</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsBroadcastStormCleared</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsBroadcastStormCleared</event-label>
      <descr>&lt;p&gt;Broadcast traffic on port &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% (%parm[#2]%) is back below the threshold (%parm[#3]% packets per second).&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;Broadcast storm on %parm[#1]% cleared.&lt;/p&gt;</logmsg>
      <severity>Normal</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="2"
                  clear-key="uei.opennms.org/vendor/RANSecure/traps/rsBroadcastStorm:%dpname%:%nodeid%:%parm[#1]%"
