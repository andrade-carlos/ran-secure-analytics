<events xmlns="http://xmlns.opennms.org/xsd/eventconf">
   <!--
     RAN-Secure Analytics Platform - event definitions for RAN-SECURE-NET-SIM-MIB notifications
     (simulated IP/MPLS routers, Ethernet switches, DWDM and GPON OLTs).

     SNMPv2 trap OIDs .1.3.6.1.4.1.32473.7.9.0.N are mapped by Horizon (RFC 3584)
     to enterprise .1.3.6.1.4.1.32473.7.9, generic 6, specific N.

     Every problem event raises an alarm (alarm-type 1) whose reduction key includes the
     node and the affected object (LSP, peer, port, PON); the matching recovery event
     (alarm-type 2) clears it automatically.

     Horizon 35+ stores event definitions in the database: this file is uploaded by
     scripts/provision.sh through POST /opennms/api/v2/eventconf/upload.
   -->
   <event>
      <mask>
         <maskelement><mename>id</mename><mevalue>.1.3.6.1.4.1.32473.7.9</mevalue></maskelement>
         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>1</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsLspPathProtected</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsLspPathProtected</event-label>
      <descr>&lt;p&gt;MPLS LSP &lt;b&gt;%parm[#1]%&lt;/b&gt; on %nodelabel% (towards %parm[#2]%) lost its primary path and is now carried by the &lt;b&gt;secondary path&lt;/b&gt; over the diverse fiber route.&lt;/p&gt;&lt;p&gt;Traffic is protected, but the network is running without redundancy and latency is higher. Look for the root cause in the transport layer at the same time (fiber cut, DWDM loss of signal, core link down).&lt;/p&gt;&lt;p&gt;Recommended action: restore the primary path before a second failure causes an outage.&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;LSP %parm[#1]% switched to its secondary path (protection active).&lt;/p&gt;</logmsg>
      <severity>Warning</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="1" auto-clean="false"/>
   </event>
   <event>
      <mask>
         <maskelement><mename>id</mename><mevalue>.1.3.6.1.4.1.32473.7.9</mevalue></maskelement>
         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>2</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsLspPathRestored</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsLspPathRestored</event-label>
      <descr>&lt;p&gt;MPLS LSP &lt;b&gt;%parm[#1]%&lt;/b&gt; on %nodelabel% (towards %parm[#2]%) is back on its primary path.&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;LSP %parm[#1]% back on its primary path.&lt;/p&gt;</logmsg>
      <severity>Normal</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="2"
                  clear-key="uei.opennms.org/vendor/RANSecure/traps/rsLspPathProtected:%dpname%:%nodeid%:%parm[#1]%"
                  auto-clean="false"/>
   </event>
   <event>
      <mask>
         <maskelement><mename>id</mename><mevalue>.1.3.6.1.4.1.32473.7.9</mevalue></maskelement>
         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>3</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsBgpPeerDown</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsBgpPeerDown</event-label>
      <descr>&lt;p&gt;BGP session &lt;b&gt;%parm[#1]%&lt;/b&gt; (%parm[#2]%) on %nodelabel% left the Established state. All prefixes learned from this peer were withdrawn.&lt;/p&gt;&lt;p&gt;If this is the upstream transit, Internet traffic of the operator's subscribers is affected.&lt;/p&gt;&lt;p&gt;Recommended action: check the physical link and the BGP state on both sides, the peer's maintenance notices and the session logs (hold-timer expiry, notifications received).&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;BGP peer %parm[#1]% (%parm[#2]%) is down.&lt;/p&gt;</logmsg>
      <severity>Major</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#2]%" alarm-type="1" auto-clean="false"/>
   </event>
   <event>
      <mask>
         <maskelement><mename>id</mename><mevalue>.1.3.6.1.4.1.32473.7.9</mevalue></maskelement>
         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>4</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsBgpPeerUp</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsBgpPeerUp</event-label>
      <descr>&lt;p&gt;BGP session &lt;b&gt;%parm[#1]%&lt;/b&gt; (%parm[#2]%) on %nodelabel% is Established again.&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;BGP peer %parm[#1]% (%parm[#2]%) is up.&lt;/p&gt;</logmsg>
      <severity>Normal</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#2]%" alarm-type="2"
                  clear-key="uei.opennms.org/vendor/RANSecure/traps/rsBgpPeerDown:%dpname%:%nodeid%:%parm[#2]%"
                  auto-clean="false"/>
   </event>
   <event>
