      <uei>uei.opennms.org/vendor/RANSecure/traps/rsPonRxPowerLow</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsPonRxPowerLow</event-label>
      <descr>&lt;p&gt;The worst ONU receive power on PON &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% fell to &lt;b&gt;%parm[#2]%&lt;/b&gt; (hundredths of a dBm; -2700 = -27.00 dBm), below the -27 dBm alarm threshold.&lt;/p&gt;&lt;p&gt;Subscribers are still in service, but class B+ ONUs stop working near -28 dBm. A slow decline across the PON points to a dirty or damaged connector, a macro-bend or a degrading splitter.&lt;/p&gt;&lt;p&gt;Recommended action: schedule a preventive visit to clean and inspect the connectors on the feeder and the splitter before subscribers lose service.&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;PON %parm[#1]%: worst ONU receive power %parm[#2]% (0.01 dBm) below threshold.&lt;/p&gt;</logmsg>
      <severity>Minor</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="1" auto-clean="false"/>
   </event>
   <event>
      <mask>
         <maskelement><mename>id</mename><mevalue>.1.3.6.1.4.1.32473.7.9</mevalue></maskelement>
         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>12</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsPonRxPowerNormal</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsPonRxPowerNormal</event-label>
      <descr>&lt;p&gt;ONU receive power on PON &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% is back within limits (worst ONU: %parm[#2]% hundredths of a dBm).&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;PON %parm[#1]%: ONU receive power back to normal.&lt;/p&gt;</logmsg>
      <severity>Normal</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="2"
                  clear-key="uei.opennms.org/vendor/RANSecure/traps/rsPonRxPowerLow:%dpname%:%nodeid%:%parm[#1]%"
                  auto-clean="false"/>
