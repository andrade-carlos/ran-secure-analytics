         <maskelement><mename>specific</mename><mevalue>5</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsOptLos</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsOptLos</event-label>
      <descr>&lt;p&gt;Loss of signal on optical port &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% (%parm[#2]%).&lt;/p&gt;&lt;p&gt;On a line port this usually means a fiber cut or a failed amplifier on the span; every wavelength on the span is affected. On a channel port the wavelength carrying the listed circuit is down.&lt;/p&gt;&lt;p&gt;Recommended action: correlate the loss-of-signal alarms of both ends of the span, check the optical time-domain reflectometer (OTDR) trace to locate the cut and dispatch the fiber crew.&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;Optical loss of signal on %parm[#1]% (%parm[#2]%).&lt;/p&gt;</logmsg>
      <severity>Critical</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="1" auto-clean="false"/>
   </event>
   <event>
      <mask>
         <maskelement><mename>id</mename><mevalue>.1.3.6.1.4.1.32473.7.9</mevalue></maskelement>
         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>6</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsOptLosCleared</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsOptLosCleared</event-label>
      <descr>&lt;p&gt;Optical signal restored on port &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% (%parm[#2]%).&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;Optical signal restored on %parm[#1]%.&lt;/p&gt;</logmsg>
      <severity>Normal</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="2"
                  clear-key="uei.opennms.org/vendor/RANSecure/traps/rsOptLos:%dpname%:%nodeid%:%parm[#1]%"
                  auto-clean="false"/>
   </event>
