         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>7</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsPonLos</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsPonLos</event-label>
      <descr>&lt;p&gt;All ONUs on PON &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% were lost at the same time &lt;b&gt;without dying-gasp messages&lt;/b&gt; (ONUs online now: %parm[#2]%).&lt;/p&gt;&lt;p&gt;The ONUs did not report a power failure, so the cause is in the fiber plant: the feeder fiber, the splitter or the OLT optics. Every subscriber on this PON is out of service.&lt;/p&gt;&lt;p&gt;Recommended action: dispatch the fiber crew to the feeder route of this PON; check the OLT transmit power first to rule out the OLT side.&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;PON %parm[#1]% loss of signal: feeder fiber cut suspected.&lt;/p&gt;</logmsg>
      <severity>Critical</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="1" auto-clean="false"/>
   </event>
   <event>
      <mask>
         <maskelement><mename>id</mename><mevalue>.1.3.6.1.4.1.32473.7.9</mevalue></maskelement>
         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>8</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsPonLosCleared</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsPonLosCleared</event-label>
      <descr>&lt;p&gt;ONUs are ranging again on PON &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% (ONUs online: %parm[#2]%).&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;PON %parm[#1]% back in service.&lt;/p&gt;</logmsg>
      <severity>Normal</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="2"
                  clear-key="uei.opennms.org/vendor/RANSecure/traps/rsPonLos:%dpname%:%nodeid%:%parm[#1]%"
                  auto-clean="false"/>
   </event>
