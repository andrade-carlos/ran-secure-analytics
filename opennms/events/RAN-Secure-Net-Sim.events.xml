      <uei>uei.opennms.org/vendor/RANSecure/traps/rsPonDyingGaspBurst</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsPonDyingGaspBurst</event-label>
      <descr>&lt;p&gt;&lt;b&gt;%parm[#2]% ONUs&lt;/b&gt; on PON &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% sent a dying-gasp message within a short window (ONUs still online: %parm[#3]%).&lt;/p&gt;&lt;p&gt;Dying gasp means the ONU lost mains power at the subscriber premises. Many at once on the same PON points to a &lt;b&gt;commercial power outage in the area&lt;/b&gt;, not to a fiber or OLT fault: there is no need to dispatch a fiber crew.&lt;/p&gt;&lt;p&gt;Recommended action: check the power utility's outage map, inform the customer care team, and confirm that the ONUs come back when power is restored.&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;PON %parm[#1]%: %parm[#2]% ONUs dying gasp - area power outage.&lt;/p&gt;</logmsg>
      <severity>Major</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="1" auto-clean="false"/>
   </event>
   <event>
      <mask>
         <maskelement><mename>id</mename><mevalue>.1.3.6.1.4.1.32473.7.9</mevalue></maskelement>
         <maskelement><mename>generic</mename><mevalue>6</mevalue></maskelement>
         <maskelement><mename>specific</mename><mevalue>10</mevalue></maskelement>
      </mask>
      <uei>uei.opennms.org/vendor/RANSecure/traps/rsPonDyingGaspCleared</uei>
      <event-label>RAN-SECURE-NET-SIM-MIB defined trap event: rsPonDyingGaspCleared</event-label>
      <descr>&lt;p&gt;The ONUs on PON &lt;b&gt;%parm[#1]%&lt;/b&gt; of %nodelabel% that had lost power are back online (ONUs online: %parm[#2]%).&lt;/p&gt;</descr>
      <logmsg dest="logndisplay">&lt;p&gt;PON %parm[#1]%: ONUs back after power outage.&lt;/p&gt;</logmsg>
      <severity>Normal</severity>
      <alarm-data reduction-key="%uei%:%dpname%:%nodeid%:%parm[#1]%" alarm-type="2"
                  clear-key="uei.opennms.org/vendor/RANSecure/traps/rsPonDyingGaspBurst:%dpname%:%nodeid%:%parm[#1]%"
                  auto-clean="false"/>
   </event>
